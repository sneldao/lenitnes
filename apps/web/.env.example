# Leave empty in production for same-origin relative URLs.
# Local dev: keep empty and let next.config.mjs rewrite /api/* to the API by
# setting API_INTERNAL_URL=http://localhost:8742 when launching the web app
# (the rewrite falls back to API_PORT or 8742 automatically). Do NOT set this
# to http://localhost:8742 directly — browser fetches to that origin are
# blocked by the app's own CSP (connect-src 'self' https: wss: ws:).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_NETWORK=testnet
