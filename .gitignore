# ──────────────────────────────────────────────────────────────────
# Dependencies
# ──────────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/
.pnp.*

# ──────────────────────────────────────────────────────────────────
# Build outputs
# ──────────────────────────────────────────────────────────────────
# TypeScript / Next.js
dist/
build/
out/
*.tsbuildinfo

# Next.js
.next/
next-env.d.ts.bak

# Turbo / monorepo
.turbo/

# Foundry (Solidity)
# Foundry's own .gitignore lives in contracts/.gitignore for clarity.
# These catch root-level stray Foundry artifacts.
cache/

# ──────────────────────────────────────────────────────────────────
# Environment & secrets
# ──────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
# Coolify / manual .env rewrites leave timestamped backups on the server;
# they must never be commit candidates.
.env.bak
.env.bak.*
*.pem
*.key
secrets/

# x402 payer wallet (generated locally by scripts/x402-setup-payer.ts)
.x402-payer.json
apps/api/.x402-payer.json

# ──────────────────────────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ──────────────────────────────────────────────────────────────────
# Test / coverage
# ──────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ──────────────────────────────────────────────────────────────────
# OS / editor
# ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.cache/

# ──────────────────────────────────────────────────────────────────
# Tool caches
# ──────────────────────────────────────────────────────────────────
.blackboxcli/
.antigravitycli/
.qoder/
.eslintcache
.stylelintcache
*.tsbuildinfo
.commandcode/
.claude/
videos/

